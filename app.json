{
  "expo": {
    "name": "FinanceTracker",
    "slug": "FinanceTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kosh/kosh-icon-1024.png",
    "scheme": "financetracker",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E5A52",
        "foregroundImage": "./assets/images/kosh/kosh-adaptive-foreground-1024.png",
        "monochromeImage": "./assets/images/kosh/kosh-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kundan2001.FinanceTracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kosh/kosh-favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EC",
          "image": "./assets/images/kosh/kosh-icon-1024.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#121815",
            "image": "./assets/images/kosh/kosh-icon-1024.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/kosh/kosh-monochrome-1024.png",
          "color": "#0E5A52"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7e0d3c4-44e0-4512-b35a-516857ff970f"
      }
    }
  }
}
